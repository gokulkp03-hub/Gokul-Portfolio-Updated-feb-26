VITE_APP_LOGO=/gokul-profile.png
VITE_APP_TITLE="Gokul Portfolio"
VITE_ANALYTICS_ENDPOINT="https://analytics.example.com"
VITE_ANALYTICS_WEBSITE_ID="00000000-0000-0000-0000-000000000000"

# --- Admin login (server-side; set these in Vercel for Production AND Preview) ---
# Login is disabled unless ADMIN_USERNAME and a password are set. There are no defaults.
ADMIN_USERNAME=
# Preferred: generate with `pnpm hash-password` and paste the output here.
ADMIN_PASSWORD_HASH=
# Legacy plain-text password; only used when ADMIN_PASSWORD_HASH is empty.
ADMIN_PASSWORD=
JWT_SECRET=
OWNER_OPEN_ID=

# --- Lead notifications (set at least one, or new enquiries are only visible in /admin/contact) ---
# Email via https://resend.com. Without a verified domain, Resend only delivers
# from onboarding@resend.dev to your Resend account's own email address.
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=
# Optional: Slack incoming webhook (Discord: append /slack to the webhook URL).
LEAD_WEBHOOK_URL=

# --- Media uploads on Vercel: create a Blob store (Storage tab) and connect it; Vercel sets this. ---
BLOB_READ_WRITE_TOKEN=

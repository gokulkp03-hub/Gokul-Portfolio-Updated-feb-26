{
  "installCommand": "pnpm install --ignore-scripts",
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "gokul-folio.vercel.app"
        }
      ],
      "destination": "https://www.gokulkp.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blogs/(.*)",
      "destination": "/api/seo-injector"
    },
    {
      "source": "/portfolio/(.*)",
      "destination": "/api/seo-injector"
    },
    {
      "source": "/marketing/(.*)",
      "destination": "/api/seo-injector"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

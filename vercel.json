{
  "installCommand": "pnpm install --ignore-scripts",
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blogs/:slug",
      "destination": "/api/seo-injector"
    },
    {
      "source": "/portfolio/:category/:slug",
      "destination": "/api/seo-injector"
    },
    {
      "source": "/marketing/:slug",
      "destination": "/api/seo-injector"
    },
    {
      "source": "/api/trpc/:trpc*",
      "destination": "/api/trpc/[trpc]"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

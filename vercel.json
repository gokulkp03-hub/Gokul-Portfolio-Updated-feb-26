{
  "installCommand": "pnpm install --ignore-scripts",
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "gokul-folio.vercel.app"
        }
      ],
      "destination": "https://www.gokulkp.com/$1",
      "permanent": true
    },
    {
      "source": "/portfolio/video",
      "destination": "/video",
      "permanent": true
    },
    {
      "source": "/portfolio/photo",
      "destination": "/photo",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/assets/images/logos/prepmeal.png",
      "destination": "/assets/images/logos/PrepMeal.png"
    },
    {
      "source": "/assets/images/logos/acero.png",
      "destination": "/assets/images/logos/Acero.png"
    },
    {
      "source": "/assets/images/logos/q4c.png",
      "destination": "/assets/images/logos/Q4c.png"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/blogs/(.*)",
      "destination": "/api/seo-injector"
    },
    {
      "source": "/portfolio/(.*)",
      "destination": "/api/seo-injector"
    },
    {
      "source": "/marketing/(.*)",
      "destination": "/api/seo-injector"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://api.fontshare.com; font-src 'self' https://fonts.gstatic.com https://api.fontshare.com https://cdn.fontshare.com data:; img-src 'self' data: blob: https://res.cloudinary.com https://images.unsplash.com https://www.googletagmanager.com https://www.google-analytics.com; media-src 'self' data: blob: https://res.cloudinary.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://res.cloudinary.com https://api.fontshare.com; frame-src 'self' https://www.googletagmanager.com https://player.cloudinary.com https://www.youtube.com; object-src 'none'; base-uri 'self';"
        }
      ]
    }
  ]
}

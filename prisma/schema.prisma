generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  category        String
  description     String?
  tags            Json      @default("[]")
  client          String?
  year            Int?
  thumbnail       String
  gallery         Json      @default("[]")
  videoUrl        String?
  videoType       String?
  directVideoUrl  String?
  summary         String?
  problem         String?
  solution        String?
  results         Json      @default("[]")
  tools           Json      @default("[]")
  credits         Json      @default("[]")
  featured        Boolean   @default(false)
  sortOrder       Int       @default(0)
  status          String    @default("draft")
  publishDate     DateTime?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  views           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SiteContent {
  id           Int      @id @default(autoincrement())
  heroTitle    String?
  heroSubtitle String?
  aboutText    String?
  services     Json?
  skills       Json?
  socials      Json?
  contact      Json?
  sections     Json?
  updatedAt    DateTime @updatedAt
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  order Int    @default(0)
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique
}

model Media {
  id        String   @id @default(cuid())
  url       String
  type      String
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Revision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  data       Json
  createdAt  DateTime @default(now())
}

model User {
  id           Int      @id @default(autoincrement())
  openId       String   @unique
  name         String?
  email        String?
  loginMethod  String?
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSignedIn DateTime @default(now())
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  service   String
  details   String?
  createdAt DateTime @default(now())
}
